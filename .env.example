# Generate distinct secrets: openssl rand -hex 32
APP_URL=http://localhost:3000
APP_BIND=127.0.0.1
APP_PORT=3000
DATABASE_URL=postgresql://sidedesk:REPLACE_DATABASE_PASSWORD@postgres:5432/sidedesk
POSTGRES_PASSWORD=REPLACE_DATABASE_PASSWORD
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SETUP_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
FILE_STORAGE_PATH=/data/uploads
BACKUP_DIR=/data/backups
TZ=America/Edmonton
NEXT_TELEMETRY_DISABLED=1

# Optional authenticated SMTP: generate a distinct key with openssl rand -hex 32.
# Preserve outside backups. Never reuse SESSION_SECRET or a vault key/password.
# SMTP_ENCRYPTION_KEY=64_HEX_CHARACTERS_FROM_A_UNIQUE_RANDOM_KEY
# Optional trusted private SMTP CA, mounted read-only inside the container:
# SMTP_CA_FILE=/run/sidedesk/smtp-ca.pem
